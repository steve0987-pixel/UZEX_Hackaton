TELEGRAM_BOT_TOKEN=
# Optional: comma-separated Telegram user IDs. Empty means public access.
TELEGRAM_ALLOWED_USERS=
AI_PROVIDER=auto
# With GROQ_API_KEY configured, auto uses Groq. Only the question/schema are sent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: local Ollama enables free-form Russian/Uzbek/English questions.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
UZEX_DB=runtime/uzex.sqlite3
# Public HTTPS address of miniapp/dist, after publication.
MINIAPP_URL=
